# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sparetrack

# Authentication (Argon2 + JWT)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars

# Google Generative AI (Gemini Vision Extraction)
# Never expose this key in the frontend mobile bundle
GEMINI_API_KEY=your-gemini-api-key-here
